# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets & credentials
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
secrets/
credentials/
service-account*.json
*-service-account.json
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
.secrets

# config files that may contain sensitive data
config/secrets.yml
config/credentials.yml.enc
config/master.key

# vercel
.vercel

# claude
.claude

# supabase
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
